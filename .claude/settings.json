      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__list_projects"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r /:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(DROP TABLE:*)",
      "Bash(DROP DATABASE:*)",
      "Bash(TRUNCATE:*)",
      "Bash(DELETE FROM:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(chmod 777:*)",
      "Bash(eval:*)",
      "Bash(sudo:*)",
      "Bash(npm:*)",
      "Bash(npx -y:*)"
    ],
    "additionalDirectories": [
      "c:\\Users\\Minotti\\Documents\\Projects\\zapfome-dashboard\\.claude"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx prettier --write \"$TOOL_INPUT_FILE\" 2>/dev/null; exit 0",
            "if": "Edit(src/**/*.{ts,tsx}) | Write(src/**/*.{ts,tsx})",
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && yarn lint --quiet 2>/dev/null; exit 0",
            "statusMessage": "Running linter..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && yarn typecheck 2>&1 | tail -20; exit 0",
            "statusMessage": "Type-checking..."
          }
        ]
      }
    ]
  }
}
